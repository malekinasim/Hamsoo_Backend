    <subDataset name="S" uuid="1871edf3-83de-4ee4-983d-47a5eeada46a">
        <property name="com.jaspersoft.studio.data.sql.tables" value=""/>
        <property name="com.jaspersoft.studio.data.defaultdataadapter" value="hamsoo"/>
        <parameter name="MODEL_VERSION_ID" class="java.lang.Long"/>
        <queryString language="SQL">
            <![CDATA[select distinct
CASE
    WHEN sct.code = 'IN_PRC' THEN insc_model."name"
    WHEN sct.code = 'EX_PRC' THEN exsc."name"
    WHEN sct.code = 'EVENT' THEN sc.event_sup_cust
END AS sup_cust_name
from bpm.bpm_identity_io_sup_custs sc
inner join bpm.bpm_identity_io ii on ii.identity_io_id = sc.identity_io_id
inner join bpm.bpm_model_versions mv on mv.model_version_id = ii.model_version_id
inner join bpm.bpm_code_category iit on iit.code_category_id = ii."type"
inner join bpm.bpm_code_category sct on sct.code_category_id = sc."type"
left join bpm.bpm_model_versions insc on insc.model_version_id = sc.internal_sup_cust
left join bpm.bpm_models insc_model on insc_model.model_id = insc.model_id
left join bpm.bpm_external_process exsc on exsc.id = sc.external_sup_cust
where mv.model_version_id= $P{MODEL_VERSION_ID} and iit.code = 'INPUT'
and ii.status = 'ACTIVE' and sc.status = 'ACTIVE';]]>
        </queryString>
        <field name="sup_cust_name" class="java.lang.String">
            <property name="com.jaspersoft.studio.field.name" value="sup_cust_name"/>
            <property name="com.jaspersoft.studio.field.label" value="sup_cust_name"/>
        </field>
    </subDataset>
    <parameter name="MODEL_VERSION_ID" class="java.lang.Long"/>
    <parameter name="CURRENT_DATE_PERSIAN" class="java.lang.String"/>
    <queryString language="SQL">
        <![CDATA[SELECT  m.name model_name, m.code model_code,
model_type.fa_name model_type,model_status.fa_name model_status, o.name organ_name,
organ_logo.byte_content organ_logo , model_image.byte_content model_image
FROM bpm.bpm_model_versions mv
inner join bpm.bpm_models m on mv.model_id = m.model_id
inner join bpm.bpm_code_category model_type on m.model_type = model_type.code_category_id
inner join bpm.bpm_code_category model_status on mv.status_id = model_status.code_category_id
inner join bpm.bpm_organs o on m.organ_id = o.organ_id
left join bpm.bpm_files organ_logo on o.organ_logo = organ_logo.file_id
left join bpm.bpm_files model_image on mv.bpmn_img = model_image.file_id
where mv.model_version_id=$P{MODEL_VERSION_ID};]]>
    </queryString>
